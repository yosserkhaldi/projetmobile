PORT=3000
DATABASE_URL=postgresql://monconstat:monconstat@localhost:5434/monconstat
JWT_SECRET=remplacer-par-un-secret-local

# Facultatif. Sans SMTP, les e-mails s'affichent dans les logs de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@monconstat.tn

# Photos envoyées. En Docker : volume monté sur /app/uploads.
UPLOAD_DIR=uploads

# Facultatif : active Claude. Sans clé, le module 5 répond avec ses règles.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Base dédiée aux tests d'API du module 5, facultative.
# TEST_DATABASE_URL=postgresql://monconstat:monconstat@localhost:5434/monconstat_test
# Facultatif : codes de vérification sur WhatsApp via OpenWA
# (docker compose --profile whatsapp up, puis lier un numéro de réserve sur http://localhost:2785).
# Clé : docker compose exec whatsapp cat /app/data/.api-key
WHATSAPP_API_URL=http://localhost:2785/api
WHATSAPP_API_KEY=
WHATSAPP_SESSION=monconstat
