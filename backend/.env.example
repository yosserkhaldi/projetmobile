PORT=3000
DATABASE_URL=postgresql://monconstat:monconstat@localhost:5434/monconstat
JWT_SECRET=remplacer-par-un-secret-local

# Facultatif. Sans SMTP, les e-mails s'affichent dans les logs de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@monconstat.tn

# Photos envoyées. En Docker : volume monté sur /app/uploads.
UPLOAD_DIR=uploads

# ── IA du module 5 (facultatif) ──────────────────────────────────────────────
# Sans fournisseur, ou s'il échoue, le module répond avec ses règles.
# AI_PROVIDER : auto (défaut), claude-cli, anthropic, openai, perplexity, none.
# En auto : en développement, la CLI Claude Code de la machine si elle est
# installée (votre compte Claude, sans clé), puis la première clé ci-dessous.
# En production (NODE_ENV=production), jamais la CLI. Docker n'a pas la CLI :
# pour l'utiliser, lancez l'API sur la machine (npm run dev).
# AI_PROVIDER=auto

# CLI Claude Code : trouvée dans le PATH ou l'extension VS Code, sinon :
# CLAUDE_CLI_PATH=/chemin/vers/claude
# Modèle des deux voies Claude (CLI : claude-sonnet-5-5, clé : claude-opus-5-5).
# CLAUDE_MODEL=

# Claude par clé d'API.
# ANTHROPIC_API_KEY=

# Toute API au format OpenAI : OpenAI, Mistral, Groq, OpenRouter, Ollama…
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_LABEL=OpenAI
# Exemple Ollama local, sans clé : OPENAI_BASE_URL=http://localhost:11434/v1
# et OPENAI_MODEL=llama3.1

# Passerelle Perplexity (format OpenAI, recherche web désactivée).
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# Base dédiée aux tests d'API du module 5, facultative.
# TEST_DATABASE_URL=postgresql://monconstat:monconstat@localhost:5434/monconstat_test

# Facultatif : codes de vérification sur WhatsApp via OpenWA
# (docker compose --profile whatsapp up, puis lier un numéro de réserve sur http://localhost:2785).
# Clé : docker compose exec whatsapp cat /app/data/.api-key
WHATSAPP_API_URL=http://localhost:2785/api
WHATSAPP_API_KEY=
WHATSAPP_SESSION=monconstat
