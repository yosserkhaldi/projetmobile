{
  "name": "mon-constat-digital-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test --test-concurrency=1",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "ml:train": "node src/modules/claims/ai/train.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
