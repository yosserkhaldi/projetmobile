{
  "openapi": "3.0.3",
  "info": {
    "title": "Mon Constat Digital : module 5",
    "version": "1.0.0",
    "description": "Sinistres, suivi, notifications et messagerie. Hors production, identité par en-têtes x-user-id, x-user-role et x-user-name en attendant le module 1."
  },
  "servers": [
    {
      "url": "/api/claims"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "devUser": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "devUser": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id"
      }
    },
    "parameters": {
      "ClaimId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": {
          "type": "string"
        },
        "description": "Un renvoi avec la même clé ne s'applique pas deux fois."
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Lister les sinistres",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Transmettre un dossier (conducteur)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "place",
                  "date",
                  "severity"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "place": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "observations": {
                    "type": "string"
                  },
                  "circumstances": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "impactZones": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sync": {
      "get": {
        "summary": "Dossiers, notifications et messages de l'utilisateur",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/notifications": {
      "get": {
        "summary": "Centre de notifications",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/notifications/read": {
      "post": {
        "summary": "Marquer des notifications lues",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/files/document/{id}": {
      "get": {
        "summary": "Télécharger une pièce",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          }
        ]
      }
    },
    "/files/message/{id}": {
      "get": {
        "summary": "Télécharger une pièce jointe",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          }
        ]
      }
    },
    "/{id}": {
      "get": {
        "summary": "Dossier complet",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          }
        ]
      }
    },
    "/{id}/take-charge": {
      "post": {
        "summary": "Prendre en charge (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/{id}/document-requests": {
      "post": {
        "summary": "Demander une pièce (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/documents": {
      "post": {
        "summary": "Déposer une pièce",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "requestId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/expertise": {
      "post": {
        "summary": "Désigner un expert (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expertName": {
                    "type": "string"
                  },
                  "appointment": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/expert-report": {
      "post": {
        "summary": "Joindre le rapport d'expertise (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/close": {
      "post": {
        "summary": "Clôturer (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "responsibility": {
                    "type": "integer",
                    "enum": [
                      0,
                      50,
                      100
                    ]
                  },
                  "indemnity": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/reject": {
      "post": {
        "summary": "Rejeter avec un motif (agent)",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/messages": {
      "get": {
        "summary": "Messages du dossier",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          }
        ]
      },
      "post": {
        "summary": "Envoyer un message",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "id": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{id}/messages/read": {
      "post": {
        "summary": "Accusé de lecture",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ClaimId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    }
  }
}