// Module 1 : utilisateurs et compagnies.
// Les autres modules ajoutent leurs modèles ici. Le schéma est validé par l'équipe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  AGENT
  ADMIN
}

enum Language {
  FR
  AR
  EN
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CodePurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(DRIVER)
  active          Boolean   @default(true)
  phoneVerifiedAt DateTime?
  language        Language  @default(FR)
  licenseNumber   String?
  licenseCategory String?
  licenseIssuedAt DateTime? @db.Date
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  companyId       String?   @db.Uuid
  // Noms de fichiers dans UPLOAD_DIR/users. Jamais servis publiquement.
  photoFile        String?
  licensePhotoFile String?
  // Vérification d'identité (CIN) : validée par un administrateur.
  identityStatus          IdentityStatus @default(UNVERIFIED)
  cinNumber               String?        @unique
  cinFrontFile            String?
  cinBackFile             String?
  identitySubmittedAt     DateTime?
  identityReviewedAt      DateTime?
  identityReviewerId      String?        @db.Uuid
  identityRejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  deviceKeys        DeviceKey[]
  sessions          Session[]
  loginEvents       LoginEvent[]

  @@index([role])
  @@index([companyId])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  agencies Agency[]
  agents   User[]
}

model Agency {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  city      String
  companyId String @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

// Un appareil connecté. Ses jetons de rafraîchissement se succèdent ;
// révoquer la session déconnecte l'appareil tout de suite.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String?
  deviceName String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  sessionId String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// Historique des connexions, réussies ou non.
model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  success    Boolean
  method     String
  reason     String?
  deviceName String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Connexion biométrique : clé longue durée gardée sur l'appareil,
// utilisable seulement après l'empreinte ou la reconnaissance faciale.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
