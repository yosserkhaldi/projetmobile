// Module 1 : utilisateurs et compagnies.
// Les autres modules ajoutent leurs modèles ici. Le schéma est validé par l'équipe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  AGENT
  ADMIN
}

enum Language {
  FR
  AR
  EN
}

enum CodePurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(DRIVER)
  active          Boolean   @default(true)
  phoneVerifiedAt DateTime?
  language        Language  @default(FR)
  licenseNumber   String?
  licenseCategory String?
  licenseIssuedAt DateTime? @db.Date
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  companyId       String?   @db.Uuid
  // Noms de fichiers dans UPLOAD_DIR/users. Jamais servis publiquement.
  photoFile        String?
  licensePhotoFile String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  deviceKeys        DeviceKey[]
  vehicles          Vehicle[]

  @@index([role])
  @@index([companyId])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  agencies Agency[]
  agents   User[]
}

model Agency {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  city      String
  companyId String @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Connexion biométrique : clé longue durée gardée sur l'appareil,
// utilisable seulement après l'empreinte ou la reconnaissance faciale.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Module 2 : véhicules et contrats d'assurance ──────────────────────────────
// Stockage côté serveur pour la synchronisation multi-appareils et les rapports
// d'assurance. Le SQLite local (Drift) reste la source de vérité hors-ligne ;
// ce modèle est synchronisé quand le réseau est disponible.

enum VehicleType {
  CAR
  MOTO
  TRUCK
  VAN
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  plate           String
  brand           String
  model           String
  year            Int
  policy          String
  insurerName     String      @default("")
  insuranceExpiry DateTime    @db.Date
  technicalExpiry DateTime?   @db.Date
  color           String?
  mileage         Int?
  type            VehicleType @default(CAR)
  fuel            FuelType    @default(PETROL)
  photoFile       String?
  claimCount      Int         @default(0)
  archived        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, archived])
  // Unicité de la plaque par utilisateur (un même véhicule ne peut être
  // enregistré deux fois par le même conducteur).
  @@unique([userId, plate])
}
