// Module 1 : utilisateurs et compagnies.
// Les autres modules ajoutent leurs modèles ici. Le schéma est validé par l'équipe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  AGENT
  ADMIN
}

enum Language {
  FR
  AR
  EN
}

// Pièce présentée pour la vérification d'identité.
enum IdentityDocument {
  CIN
  LICENSE
  PASSPORT
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CodePurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AccidentStatus {
  DRAFT
  SUBMITTED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(DRIVER)
  active          Boolean   @default(true)
  phoneVerifiedAt DateTime?
  language        Language  @default(FR)
  licenseNumber   String?
  licenseCategory String?
  licenseIssuedAt DateTime? @db.Date
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  companyId       String?   @db.Uuid
  // Noms de fichiers dans UPLOAD_DIR/users. Jamais servis publiquement.
  photoFile        String?
  licensePhotoFile String?
  // Lu sur la photo du permis par l'OCR (numéro, catégories, dates).
  licenseReading   Json?
  // Vérification d'identité : pièce (CIN, permis ou passeport) et visage
  // comparés par l'IA, sinon décision d'un administrateur.
  identityStatus          IdentityStatus @default(UNVERIFIED)
  identityDocument        IdentityDocument @default(CIN)
  // Numéro de la pièce présentée (nom historique : la CIN était la seule pièce).
  cinNumber               String?        @unique
  cinFrontFile            String?
  cinBackFile             String?
  // Photo de face prise pendant la vérification du visage. Effacée dès la décision.
  identitySelfieFile      String?
  identityLivenessAt      DateTime?
  // Ressemblance entre la pièce et le visage, de 0 à 1.
  identityFaceMatch       Float?
  identityAutoVerified    Boolean        @default(false)
  // Lu sur la pièce par l'OCR (numéro, et pour un passeport nom et dates).
  identityExtracted       Json?
  // Résultat des contrôles automatiques, montré à l'administrateur.
  identityChecks          Json?
  // Refus : 3 au plus, 24 h entre deux demandes ; un refus grave bloque.
  identityRefusals        Int            @default(0)
  identityRetryAt         DateTime?
  identityBlocked         Boolean        @default(false)
  // Accord explicite pour l'analyse du visage (donnée sensible, loi 2004-63).
  identityBiometricConsentAt DateTime?
  identitySubmittedAt     DateTime?
  identityReviewedAt      DateTime?
  identityReviewerId      String?        @db.Uuid
  identityRejectionReason String?
  // Loi n° 2004-63 : consentement à l'inscription, compte anonymisé à la suppression.
  consentAt               DateTime?
  deletedAt               DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  deviceKeys        DeviceKey[]
  accidents         Accident[]
  sessions          Session[]
  loginEvents       LoginEvent[]
  identityAttempts  IdentityAttempt[]
  vehicles          Vehicle[]

  @@index([role])
  @@index([companyId])
}

// Module 3 : copie serveur d'une déclaration créée hors ligne.
// `clientId` rend les synchronisations répétées idempotentes et `payload`
// conserve l'ensemble du formulaire sans dépendre des modules 2, 4 ou 5.
model Accident {
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String
  userId      String         @db.Uuid
  status      AccidentStatus @default(DRAFT)
  currentStep Int            @default(0)
  place       String
  occurredAt  DateTime
  payload     Json
  revision    Int            @default(1)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, status, updatedAt])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  agencies Agency[]
  agents   User[]
  vehicles Vehicle[]
}

model Agency {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  city      String
  companyId String @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

// Un appareil connecté. Ses jetons de rafraîchissement se succèdent ;
// révoquer la session déconnecte l'appareil tout de suite.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String?
  deviceName String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  sessionId String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// Historique des connexions, réussies ou non.
// Historique des demandes de vérification d'identité, pour l'administrateur.
model IdentityAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  documentType IdentityDocument
  number       String
  faceMatch    Float?
  checks       Json?
  // AUTO_VERIFIED, PENDING, VERIFIED ou REJECTED.
  outcome      String
  reason       String?
  severe       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  success    Boolean
  method     String
  reason     String?
  deviceName String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Connexion biométrique : clé longue durée gardée sur l'appareil,
// utilisable seulement après l'empreinte ou la reconnaissance faciale.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Module 2 : véhicules et contrats d'assurance ──────────────────────────────
// Stockage côté serveur pour la synchronisation multi-appareils et les rapports
// d'assurance. Le SQLite local (Drift) reste la source de vérité hors-ligne ;
// ce modèle est synchronisé quand le réseau est disponible.

enum VehicleType {
  CAR
  MOTO
  TRUCK
  VAN
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  plate           String
  brand           String
  model           String
  year            Int
  policy          String
  insurerName     String      @default("")
  companyId       String?     @db.Uuid
  insuranceExpiry DateTime    @db.Date
  technicalExpiry DateTime?   @db.Date
  color           String?
  mileage         Int?
  type            VehicleType @default(CAR)
  fuel            FuelType    @default(PETROL)
  photoFile       String?
  claimCount      Int         @default(0)
  archived        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, archived])
  // Unicité de la plaque par utilisateur (un même véhicule ne peut être
  // enregistré deux fois par le même conducteur).
  @@unique([userId, plate])
}
