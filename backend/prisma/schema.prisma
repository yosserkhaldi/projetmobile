// Module 1 : utilisateurs et compagnies.
// Les autres modules ajoutent leurs modèles ici. Le schéma est validé par l'équipe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  AGENT
  ADMIN
}

enum Language {
  FR
  AR
  EN
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CodePurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AccidentStatus {
  DRAFT
  SUBMITTED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(DRIVER)
  active          Boolean   @default(true)
  phoneVerifiedAt DateTime?
  language        Language  @default(FR)
  licenseNumber   String?
  licenseCategory String?
  licenseIssuedAt DateTime? @db.Date
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  companyId       String?   @db.Uuid
  // Noms de fichiers dans UPLOAD_DIR/users. Jamais servis publiquement.
  photoFile        String?
  licensePhotoFile String?
  // Vérification d'identité (CIN) : validée par un administrateur.
  identityStatus          IdentityStatus @default(UNVERIFIED)
  cinNumber               String?        @unique
  cinFrontFile            String?
  cinBackFile             String?
  identitySubmittedAt     DateTime?
  identityReviewedAt      DateTime?
  identityReviewerId      String?        @db.Uuid
  identityRejectionReason String?
  // Loi n° 2004-63 : consentement à l'inscription, compte anonymisé à la suppression.
  consentAt               DateTime?
  deletedAt               DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  deviceKeys        DeviceKey[]
  accidents         Accident[]
  sessions          Session[]
  loginEvents       LoginEvent[]
  vehicles          Vehicle[]

  @@index([role])
  @@index([companyId])
}

// Module 3 : copie serveur d'une déclaration créée hors ligne.
// `clientId` rend les synchronisations répétées idempotentes et `payload`
// conserve l'ensemble du formulaire sans dépendre des modules 2, 4 ou 5.
model Accident {
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String
  userId      String         @db.Uuid
  status      AccidentStatus @default(DRAFT)
  currentStep Int            @default(0)
  place       String
  occurredAt  DateTime
  payload     Json
  revision    Int            @default(1)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, status, updatedAt])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  agencies Agency[]
  agents   User[]
  vehicles Vehicle[]
}

model Agency {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  city      String
  companyId String @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

// Un appareil connecté. Ses jetons de rafraîchissement se succèdent ;
// révoquer la session déconnecte l'appareil tout de suite.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String?
  deviceName String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  sessionId String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// Historique des connexions, réussies ou non.
model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  success    Boolean
  method     String
  reason     String?
  deviceName String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Connexion biométrique : clé longue durée gardée sur l'appareil,
// utilisable seulement après l'empreinte ou la reconnaissance faciale.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Module 5 : sinistres, suivi, notifications, messagerie.
// driverId, agentId, companyId et constatId restent de simples identifiants :
// pas de clé étrangère vers les tables des autres modules.
model Claim {
  id                String    @id
  constatId         String?
  companyId         String?
  driverId          String
  agentId           String?
  agentName         String?
  type              String
  place             String
  date              String
  status            String
  severity          String
  observations      String    @default("")
  circumstances     String[]
  impactZones       String[]
  expertName        String?
  expertAppointment DateTime?
  expertPhone       String?
  // Lieu du rendez-vous : garage, agence, cabinet médical.
  expertPlace       String?
  // « Véhicule » ou « Corporelle » (blessé, piéton).
  expertKind        String?
  // Créneau : « proposed » puis « accepted » ; appointmentBy : driver ou agent.
  appointmentState  String?
  appointmentBy     String?
  appointmentNote   String?
  responsibility    Int?
  indemnity         Float?
  decisionReason    String?
  // Proposition du système au moment de la décision, pour mesurer l'écart.
  aiProposal        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events     ClaimEvent[]
  documents  ClaimDocument[]
  requests   DocumentRequest[]
  messages   ChatMessage[]
}

model ClaimEvent {
  id        Int      @id @default(autoincrement())
  claimId   String
  label     String
  createdAt DateTime @default(now())
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model ClaimDocument {
  id         String   @id
  claimId    String
  name       String
  kind       String   @default("Pièce")
  storedName String?
  requestId  String?
  // Données lues dans la pièce par Claude, absentes sans clé.
  analysis   Json?
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model DocumentRequest {
  id         String   @id
  claimId    String
  label      String
  note       String   @default("")
  documentId String?
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model ClaimNotification {
  id          String   @id @default(uuid())
  claimId     String?
  audience    String
  recipientId String?
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([audience, recipientId])
}

model ChatMessage {
  id               String   @id
  claimId          String
  author           String
  senderRole       String
  body             String   @default("")
  attachmentName   String?
  attachmentStored String?
  read             Boolean  @default(false)
  sentAt           DateTime @default(now())
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// Une ligne par requête déjà appliquée : un renvoi ne s'applique pas deux fois.
model ProcessedRequest {
  key       String   @id
  status    Int
  body      Json
  createdAt DateTime @default(now())
}

// Texte généré par Claude, réutilisé tant que le dossier ne change pas.
model ClaimAiNote {
  claimId   String
  kind      String
  hash      String
  text      String
  // Modèle qui a rédigé le texte, affiché dans l'application.
  by        String?
  updatedAt DateTime @updatedAt

  @@id([claimId, kind])
}

// Journal des appels aux modèles : fournisseur (source), coût, échecs, qui a demandé quoi.
model AiCall {
  id           Int      @id @default(autoincrement())
  claimId      String?
  feature      String
  actorRole    String
  source       String
  model        String?
  ok           Boolean
  error        String?
  inputTokens  Int?
  outputTokens Int?
  ms           Int?
  createdAt    DateTime @default(now())

  @@index([claimId])
}

// ── Module 2 : véhicules et contrats d'assurance ──────────────────────────────
// Stockage côté serveur pour la synchronisation multi-appareils et les rapports
// d'assurance. Le SQLite local (Drift) reste la source de vérité hors-ligne ;
// ce modèle est synchronisé quand le réseau est disponible.

enum VehicleType {
  CAR
  MOTO
  TRUCK
  VAN
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  plate           String
  brand           String
  model           String
  year            Int
  policy          String
  insurerName     String      @default("")
  companyId       String?     @db.Uuid
  insuranceExpiry DateTime    @db.Date
  technicalExpiry DateTime?   @db.Date
  color           String?
  mileage         Int?
  type            VehicleType @default(CAR)
  fuel            FuelType    @default(PETROL)
  photoFile       String?
  claimCount      Int         @default(0)
  archived        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, archived])
  // Unicité de la plaque par utilisateur (un même véhicule ne peut être
  // enregistré deux fois par le même conducteur).
  @@unique([userId, plate])
}
