// Module 1 : utilisateurs et compagnies.
// Les autres modules ajoutent leurs modèles ici. Le schéma est validé par l'équipe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  AGENT
  ADMIN
}

enum Language {
  FR
  AR
  EN
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CodePurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum AccidentStatus {
  DRAFT
  SUBMITTED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String
  lastName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  role            Role      @default(DRIVER)
  active          Boolean   @default(true)
  phoneVerifiedAt DateTime?
  language        Language  @default(FR)
  licenseNumber   String?
  licenseCategory String?
  licenseIssuedAt DateTime? @db.Date
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  companyId       String?   @db.Uuid
  // Noms de fichiers dans UPLOAD_DIR/users. Jamais servis publiquement.
  photoFile        String?
  licensePhotoFile String?
  // Vérification d'identité (CIN) : validée par un administrateur.
  identityStatus          IdentityStatus @default(UNVERIFIED)
  cinNumber               String?        @unique
  cinFrontFile            String?
  cinBackFile             String?
  identitySubmittedAt     DateTime?
  identityReviewedAt      DateTime?
  identityReviewerId      String?        @db.Uuid
  identityRejectionReason String?
  // Loi n° 2004-63 : consentement à l'inscription, compte anonymisé à la suppression.
  consentAt               DateTime?
  deletedAt               DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]
  deviceKeys        DeviceKey[]
  accidents         Accident[]
  sessions          Session[]
  loginEvents       LoginEvent[]
  vehicles          Vehicle[]
  constats          Constat[]

  @@index([role])
  @@index([companyId])
}

// Module 3 : copie serveur d'une déclaration créée hors ligne.
// `clientId` rend les synchronisations répétées idempotentes et `payload`
// conserve l'ensemble du formulaire sans dépendre des modules 2, 4 ou 5.
model Accident {
  id          String         @id @default(uuid()) @db.Uuid
  clientId    String
  userId      String         @db.Uuid
  status      AccidentStatus @default(DRAFT)
  currentStep Int            @default(0)
  place       String
  occurredAt  DateTime
  payload     Json
  revision    Int            @default(1)
  submittedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  constat Constat?

  @@unique([userId, clientId])
  @@index([userId, status, updatedAt])
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  agencies Agency[]
  agents   User[]
  vehicles Vehicle[]
  constatsA Constat[] @relation("CompanyAConstats")
  constatsB Constat[] @relation("CompanyBConstats")
}

model Agency {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  city      String
  companyId String @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

// Un appareil connecté. Ses jetons de rafraîchissement se succèdent ;
// révoquer la session déconnecte l'appareil tout de suite.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  deviceId   String?
  deviceName String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  sessionId String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

/// Historique des connexions, réussies ou non.
model LoginEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  success    Boolean
  method     String
  reason     String?
  deviceName String?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  purpose    CodePurpose
  codeHash   String
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Connexion biométrique : clé longue durée gardée sur l'appareil,
// utilisable seulement après l'empreinte ou la reconnaissance faciale.
model DeviceKey {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Module 2 : véhicules et contrats d'assurance ──────────────────────────────
// Stockage côté serveur pour la synchronisation multi-appareils et les rapports
// d'assurance. Le SQLite local (Drift) reste la source de vérité hors-ligne ;
// ce modèle est synchronisé quand le réseau est disponible.

enum VehicleType {
  CAR
  MOTO
  TRUCK
  VAN
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  plate           String
  brand           String
  model           String
  year            Int
  policy          String
  insurerName     String      @default("")
  companyId       String?     @db.Uuid
  insuranceExpiry DateTime    @db.Date
  technicalExpiry DateTime?   @db.Date
  color           String?
  mileage         Int?
  type            VehicleType @default(CAR)
  fuel            FuelType    @default(PETROL)
  photoFile       String?
  claimCount      Int         @default(0)
  archived        Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, archived])
  // Unicité de la plaque par utilisateur (un même véhicule ne peut être
  // enregistré deux fois par le même conducteur).
  @@unique([userId, plate])
}

// ── Module 4 : constat amiable numérique scellé ─────────────────────────────
// Créé après double signature (Conducteur A et Conducteur B).
// Inaltérable (0 modification après signature). Le hash SHA-256 certifie l'intégrité
// du document PDF original stocké côté serveur.

enum ConstatStatus {
  SIGNED
  TRANSMITTED
  ARCHIVED
}

model Constat {
  id              String        @id @default(uuid()) @db.Uuid
  accidentId      String?       @unique @db.Uuid
  userId          String        @db.Uuid
  status          ConstatStatus @default(SIGNED)

  // Empreinte cryptographique certifiée et fichier PDF scellé
  sha256Hash      String        @unique
  pdfFile         String

  // Informations conducteur A (assuré utilisateur)
  driverAName     String
  driverAPlate    String
  driverAInsurer  String
  driverAPolicy   String?
  companyAId      String?       @db.Uuid

  // Informations conducteur B (tiers / invité)
  driverBName     String
  driverBEmail    String?
  driverBPhone    String?
  driverBPlate    String
  driverBInsurer  String
  driverBPolicy   String?
  companyBId      String?       @db.Uuid

  // Données de l'accident & du constat
  place           String
  occurredAt      DateTime
  circumstancesA  String[]      @default([])
  circumstancesB  String[]      @default([])
  impactZones     String[]      @default([])
  observations    String?
  sketchData      Json?

  // Horodatage des signatures
  driverASignedAt DateTime      @default(now())
  driverBSignedAt DateTime      @default(now())

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accident        Accident?     @relation(fields: [accidentId], references: [id], onDelete: SetNull)
  companyA        Company?      @relation("CompanyAConstats", fields: [companyAId], references: [id], onDelete: SetNull)
  companyB        Company?      @relation("CompanyBConstats", fields: [companyBId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyAId])
  @@index([companyBId])
  @@index([sha256Hash])
}
